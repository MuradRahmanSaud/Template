# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Dynamic Google Spreadsheet ID
DEFAULT_SPREADSHEET_ID="1rgu0ecVE4ClteQnbARFhQrPoorqlBrbtgMbv335r3aE"

# Dynamic Google Apps Script Web App URL
DEFAULT_WEB_APP_URL="https://script.google.com/macros/s/AKfycbx7pZyoo61kvJe1vl_1W6lbtUGwGi-WplElEkOcv8V9Meiu9H6xh37nORzRd37MeZAA/exec"

# Dynamic Google Drive Target Folder
DEFAULT_FOLDER_PATH="Murad Rahman Saud"

# Public client-side environment variables (optional overrides)
VITE_DEFAULT_SPREADSHEET_ID=""
VITE_DEFAULT_WEB_APP_URL=""
VITE_DEFAULT_FOLDER_PATH=""
